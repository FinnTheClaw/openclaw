{
  "id": "functional-finn",
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "name": "Functional Finn",
  "description": "Bounded Goal admission, verified memory, and fail-closed answer release for selected agents.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agentIds", "channels", "verifierSocketPath"],
    "properties": {
      "agentIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "channels": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "verifierSocketPath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "verifierTimeoutMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 5000
      }
    }
  }
}
