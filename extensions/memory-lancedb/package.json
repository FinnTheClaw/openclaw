{
  "name": "@openclaw/memory-lancedb",
  "version": "2026.7.1",
  "description": "OpenClaw LanceDB-backed long-term memory plugin with auto-recall, auto-capture, and vector search.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "files": [
    "api.ts",
    "config.ts",
    "durable-memory-runtime.ts",
    "hybrid-memory-index.ts",
    "index.ts",
    "lancedb-runtime.ts",
    "cli-metadata.ts",
    "memory-consolidator.ts",
    "openai-memory-consolidator.ts",
    "openclaw.plugin.json",
    "README.md",
    "scale-certification.ts",
    "temporal-ledger.ts"
  ],
  "dependencies": {
    "@lancedb/lancedb": "0.30.0",
    "apache-arrow": "18.1.0",
    "openai": "6.45.0",
    "typebox": "1.3.3"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@openclaw/memory-lancedb",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.31"
    },
    "compat": {
      "pluginApi": ">=2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1"
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
