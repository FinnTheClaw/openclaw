+function countTokenValue(token) {
+  const words = {
+    one: 1, two: 2, three: 3, four: 4, five: 5, six: 6, seven: 7, eight: 8, nine: 9,
+    ten: 10, twenty: 20, thirty: 30, forty: 40, fifty: 50, sixty: 60, seventy: 70,
+    eighty: 80, ninety: 90, "one hundred": 100,
+  };
+  const normalized = String(token || "").toLowerCase().replace(/\s+/g, " ");
+  const count = /^\d+$/.test(normalized) ? Number(normalized) : words[normalized];
+  return Number.isInteger(count) && count > 0 && count <= 200 ? count : undefined;
+}
+
+function requestedSubagentCount(userText) {
+  const text = String(userText || "");
+  const countToken = "(\\d{1,3}|one|two|three|four|five|six|seven|eight|nine|ten|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|one\\s+hundred)";
+  const match = text.match(new RegExp(
