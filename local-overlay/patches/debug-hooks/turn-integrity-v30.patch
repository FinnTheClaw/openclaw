+    "i",
+  )) || text.match(new RegExp(
+    `\\b${countToken}\\s+(?:[a-z0-9_-]+\\s+){0,8}(?:subagents?|sub-agents?|workers?|child\\s+agents?)\\b`,
+    "i",
+  ));
+  return match ? countTokenValue(match[1]) : undefined;
+}
+
+function successfulToolResultCount(evidence, matcher) {
